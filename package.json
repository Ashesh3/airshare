{
  "name": "airshare",
  "version": "0.1.0",
  "description": "Live, server-relayed file transfer for browsers and terminals without storing files on disk.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ashesh3/airshare.git"
  },
  "keywords": [
    "file-transfer",
    "streaming",
    "bun",
    "relay"
  ],
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "benchmark": "bun scripts/benchmark.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/qrcode": "1.5.6",
    "jsqr": "1.4.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  }
}
